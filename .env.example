# Server-only values. Never use VITE_ for any secret.
STORE_URL=http://localhost:5173
STORE_LIVE=false
STORE_CATALOG_APPROVED=false
STORE_LEGAL_NAME=
STORE_BUSINESS_ADDRESS=
STORE_CONTACT_EMAIL=
STORE_COUNTRIES=
# Integer US cents. Set explicitly, including zero for free delivery.
STORE_SHIPPING_CENTS=
STORE_SHIPPING_LABEL=Standard delivery
STORE_SHIPPING_POLICY=
STORE_RETURNS_POLICY=
STORE_TERMS=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
# Verified sending identity, e.g. Atelier Noir <hello@your-domain.com>
CONTACT_FROM=
CONTACT_TO=
# Generate independent random secrets with: openssl rand -hex 32
RATE_LIMIT_SALT=
RECONCILE_SECRET=
